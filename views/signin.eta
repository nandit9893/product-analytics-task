<% layout('./layout/main', { title: 'Sign In' }) %>

  <link rel="stylesheet" href="/public/css/signin.css">

<div class="signin-wrapper">
  <div class="signin-card">
    <h1>Sign in</h1>

    <form method="POST" action="/auth/signin" data-async-submit>
      <div class="form-group">
        <input type="email" name="email" placeholder="Email" value="<%= it.email || '' %>" required autocomplete="email">
      </div>

      <div class="form-group">
        <input type="password" name="password" placeholder="Password" required autocomplete="current-password">
      </div>

      <div class="form-actions">
        <label class="remember-me">
          <input type="checkbox" name="rememberMe" checked>
          Remember me
        </label>
        <a href="/forgot-password" class="forgot-password">Forgot password?</a>
      </div>

<% if (it.turnstileSiteKey) { %>
        <div class="turnstile-container">
          <div class="cf-turnstile" data-sitekey="<%= it.turnstileSiteKey %>"></div>
        </div>
<% } %>

      <button type="submit" class="btn-primary" data-loading-text="Signing in...">Sign in</button>
      <div class="form-message" aria-live="polite">
<% if (it.success) { %>
        <p class="success"><%= it.success %></p>
<% } %>
<% if (it.error) { %>
        <p class="error"><%= it.error %></p>
<% } %>
      </div>
      <p class="signin-footer">Don't have an account? <a href="/auth/signup">Sign up</a></p>
    </form>
  </div>

</div>